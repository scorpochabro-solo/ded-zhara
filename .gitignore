# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (regenerated via `prisma generate`)
/src/generated/prisma

# local SQLite database
*.db
*.db-journal
*.sqlite
/prisma/*.db
/prisma/*.db-journal

# static export для GitHub Pages
/.next-export/
/out/

# исходные фото от клиента (обрабатываются в public/images)
/source-photos/
