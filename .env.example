# ─────────────────────────────────────────────────────────────
#  Дед&Жара — пример переменных окружения.
#  Скопируй в .env и заполни:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── База данных ──────────────────────────────────────────────
# Локально / VPS (по умолчанию, ноль настройки): SQLite-файл.
DATABASE_URL="file:./dev.db"
# Production на Vercel — бесплатный Postgres (Neon/Supabase). Пример:
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# (не забудь поменять provider в prisma/schema.prisma на "postgresql")

# ── Telegram-бот (уведомления о заявках) ─────────────────────
# Токен от @BotFather и chat_id чата/группы, куда слать заявки.
# Как получить chat_id — см. README.
TELEGRAM_BOT_TOKEN=        # 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=          # напр. 123456789 или -1001234567890 для группы

# ── Мини-CRM /admin ──────────────────────────────────────────
ADMIN_USER=               # логин в /admin
ADMIN_PASSWORD=           # пароль в /admin
ADMIN_SESSION_SECRET=     # длинная случайная строка для подписи cookie

# ── Опционально ──────────────────────────────────────────────
NOTIFY_EMAIL=             # дублировать заявки на почту (пусто = выключено)

# ── Яндекс Календарь (CalDAV): записи падают в календарь ──────
# Пусто = выключено. Нужен «пароль приложения» из Яндекс ID
# (Безопасность → Пароли приложений → «Календарь CalDAV»).
# Основной пароль от аккаунта НЕ использовать.
YANDEX_CALDAV_USER=       # логин Яндекса, напр. ded.zhara@yandex.ru
YANDEX_CALDAV_PASSWORD=   # пароль приложения (не основной)
YANDEX_CALDAV_CALENDAR=   # имя календаря (пусто = первый/основной)

# ── Публичный URL (OG/sitemap/canonical) ─────────────────────
NEXT_PUBLIC_SITE_URL=     # напр. https://ded-zhara.ru
